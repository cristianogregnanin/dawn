<style>
/* mi serve perché quando cliccano sul pulsante richiedi informazioni scrolla lentamente cosi leggono tutto*/
html{
        scroll-behavior: smooth;
    }
</style>

<a  href="{{ block.settings.my_button_link }}" 
id="my-button-{{ block.id }}-{{ section.id }}"
class="color-{{ block.settings.my_button_color_scheme }} button {% if block.settings.my_button_class_full_width %} button--full-width {% endif %}"
{% if block.settings.my_button_target %} target="_blank" {% endif %}
>
  <span class="my-button-request-info__icon" aria-hidden="true">
    {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
  </span>
  <span>{{ block.settings.my_button_text }}</span>
</a>  
