{% assign next_dates = product.metafields.my_fields.events.value %}
{% assign is_course = product.metafields.my_fields.is_course.value %}
{% if product.metafields.custom.activity_is_course.type == 'boolean' %}
  {% assign is_course = product.metafields.custom.activity_is_course.value %}
{% endif %}
{% assign duration_days = product.metafields.my_fields.duration.value | default: 1 | plus: 0 %}
{% if product.metafields.custom.activity_duration_days.type == 'number_integer' %}
  {% assign duration_days = product.metafields.custom.activity_duration_days.value | plus: 0 %}
{% endif %}
{% if next_dates != blank %}
  {% if next_dates.first.edition_id == blank %}
    {% render 'collapsible-tab-events-legacy', product: product, block: block, section: section %}
  {% else %}
    {% assign today = 'now' | date: '%Y-%m-%d' %}
    {% assign visible_count = 0 %}
    {% for day in next_dates %}
      {% assign day_on = day.start_time.normal | date: '%Y-%m-%d' %}
      {% if day_on >= today %}{% assign visible_count = visible_count | plus: 1 %}{% endif %}
    {% endfor %}
    {% if visible_count > 0 %}
      <div class="product__accordion accordion quick-add-hidden" id="collapsible_tab_events" {{ block.shopify_attributes }}>
        <details id="Details-{{ block.id }}-{{ section.id }}" open>
          <summary>
            <div class="summary__title">
              {% render 'icon-accordion', icon: block.settings.icon %}
              <h2 class="h4 accordion__title">{{ 'my.available_dates' | t }}</h2>
            </div>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
            <p class="product__dates-subtitle">{{ 'my.choose_edition' | t }}</p>
            <div class="product__dates-grid">
              {% assign previous_edition_id = blank %}
              {% assign edition_in_progress = false %}
              {% for day in next_dates %}
                {% assign day_on = day.start_time.normal | date: '%Y-%m-%d' %}
                {% if day_on >= today %}
                  {% if day.edition_id != previous_edition_id %}
                    {% assign previous_edition_id = day.edition_id %}
                    {% assign edition_duration_days = day.edition_duration_days | default: duration_days | plus: 0 %}
                    {% assign edition_in_progress = false %}
                    {% unless day.edition_bookable %}{% assign edition_in_progress = true %}{% endunless %}
                    {% for edition_day in next_dates %}
                      {% assign edition_day_on = edition_day.start_time.normal | date: '%Y-%m-%d' %}
                      {% if edition_day.edition_id == day.edition_id and edition_day_on < today %}
                        {% assign edition_in_progress = true %}
                      {% endif %}
                    {% endfor %}
                    <div class="product__date-course-label">
                      {% if day.edition_label != blank %}
                        {{ day.edition_label | escape }}
                        {% if edition_in_progress %} · {{ 'my.edition_in_progress' | t }}{% endif %}
                      {% elsif edition_in_progress and is_course %}
                        {{ 'my.edition_in_progress_title' | t }}
                      {% elsif edition_in_progress %}
                        {{ 'my.departure_in_progress_title' | t }}
                      {% elsif is_course %}
                        {% assign first_date = day.start_time.normal | date: '%d/%m/%Y' %}
                        {{ 'my.edition_starting' | t: date: first_date }}
                      {% else %}
                        {% assign first_date = day.start_time.normal | date: '%d/%m/%Y' %}
                        {{ 'my.departure_starting' | t: date: first_date }}
                      {% endif %}
                      {% if edition_duration_days > 1 %}
                        <span class="product__edition-duration">
                          {% if is_course %}
                            {{ 'my.course_duration_days' | t: count: edition_duration_days }}
                          {% else %}
                            {{ 'my.activity_duration_days' | t: count: edition_duration_days }}
                          {% endif %}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if edition_in_progress %}
                    <div class="product__date-card{% if day.end_time.normal != day.start_time.normal %} product__date-card--range{% endif %}" data-edition-id="{{ day.edition_id | escape }}">
                  {% else %}
                    <a class="product__date-card{% if day.end_time.normal != day.start_time.normal %} product__date-card--range{% endif %}" href="#MyContactForm" data-edition-id="{{ day.edition_id | escape }}">
                  {% endif %}
                    <span class="product__date-badge">{{ 'my.day_of_edition' | t }}</span>
                    <span class="product__date-full">
                      {{ day.start_time.normal | time_tag: format: 'date' }}
                      {% if day.end_time.normal != day.start_time.normal %}
                        – {{ day.end_time.normal | time_tag: format: 'date' }}
                      {% endif %}
                    </span>
                  {% if edition_in_progress %}</div>{% else %}</a>{% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </details>
      </div>
    {% endif %}
  {% endif %}
{% endif %}
